# Riot Games API (required for analyze/fetch/report)
RIOT_API_KEY=RGAPI-your-key-here

# Optional: Gemini chatbot in generated reports (proxied via POST /api/chat)
# GEMINI_API_KEY=your-gemini-key

# Public site domain (used by deploy/run.sh for Caddy + HTTPS)
DOMAIN=league-champion-analyser.eu

# MongoDB connection string used inside docker-compose (unused by the app
# until the microservices migration's later phases wire it up).
MONGO_URI=mongodb://mongo:27017/league_stats

# Port RUNNER's gRPC service listens on inside the compose network.
RUNNER_GRPC_PORT=50051

# Port RUNNER's Prometheus /metrics HTTP server listens on.
RUNNER_METRICS_PORT=9100

# Port CRON-watch's gRPC service listens on inside the compose network.
CRON_WATCH_GRPC_PORT=50052

# Port CRON-watch's Prometheus /metrics HTTP server listens on.
CRON_WATCH_METRICS_PORT=9101

# CRON-watch's own Riot API key (separate from RIOT_API_KEY above, per the
# one-key-per-service-type design -- CRON-watch's WatchPoller detection calls
# share nothing with the monolith's/RUNNER's rate-limit budget).
CRON_WATCH_RIOT_API_KEY=RGAPI-your-cron-watch-key-here

# Port PEERS' gRPC service listens on inside the compose network.
PEERS_GRPC_PORT=50053

# Port PEERS' Prometheus /metrics HTTP server listens on.
PEERS_METRICS_PORT=9102

# PEERS' own Riot API key (separate from RIOT_API_KEY/CRON_WATCH_RIOT_API_KEY
# above, per the same one-key-per-service-type design).
PEERS_RIOT_API_KEY=RGAPI-your-peers-key-here

# Optional overrides (see config.toml.example)
# ANALYZER_RIOT_ID=YourName
# ANALYZER_TAGLINE=EUW
# ANALYZER_REGION=europe
