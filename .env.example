# Commit sha every service tags its logs/metrics with (`service`/`version`/`trace_id`
# log tagging, Phase 6 -- see `os.environ.get("GIT_COMMIT", "dev")` in each service's
# __main__.py). Consumed two ways: `docker-compose.yml`'s `build.args.GIT_COMMIT`
# passes it into the image at build time (docker compose automatically loads this
# same .env file for variable substitution, i.e. `${GIT_COMMIT:-dev}`), and, if set
# here, `env_file: .env` also puts it in the running container's environment --
# redundant with (and consistent with) the value already baked into the image.
# In CI, set this to the real commit before building, e.g.:
#   GIT_COMMIT=$(git rev-parse HEAD)
# Left unset (or absent from this file), every service's Dockerfile ARG/ENV default
# ("dev") applies -- fine for local development, not meaningful for distinguishing
# deployed versions.
# GIT_COMMIT=

# Riot Games API (required for analyze/fetch/report)
RIOT_API_KEY=RGAPI-your-key-here

# Optional: Gemini chatbot in generated reports (proxied via POST /api/chat)
# GEMINI_API_KEY=your-gemini-key

# Public site domain (used by deploy/run.sh for Caddy + HTTPS)
DOMAIN=league-champion-analyser.eu

# MongoDB connection string used inside docker-compose. Consumed
# unconditionally by every process that resolves peer baselines -- PEERS'
# gRPC service, for PEERS' live-sampling benchmark cache (Phase 5, Task 3,
# analysis/peer/benchmark_cache.py / infra/live_benchmark_cache_store.py).
# Also used by PeerSampleStore (peer-game rows) and RawMatchStore (RUNNER's
# raw match/timeline store). (Phase 9 deleted `peers_mode` entirely: every
# real deployment now resolves peer baselines over gRPC unconditionally --
# `deploy/run.sh`'s bare-VPS, no-separate-services topology, which used to
# rely on the deleted `in_process` default, is no longer supported.)
MONGO_URI=mongodb://mongo:27017/league_stats

# RUNNER-specific override of MONGO_URI above. Falls back to MONGO_URI
# when unset -- only set this if RUNNER needs to talk to a different Mongo
# instance than every other service in this compose file.
# RUNNER_MONGO_URI=mongodb://mongo:27017/league_stats

# RUNNER's own PEERS_GRPC_TARGET pin: set directly in docker-compose.yml, not
# here, since RawMatchStore doesn't implement the (now fully deleted,
# Phase 9) in-process peer path's peer-game methods, so RUNNER must route
# peer comparisons through PEERS over gRPC instead -- the only path
# `_run_stage_b` has left to take.

# api-ui's own PEERS_GRPC_TARGET pin: set directly in docker-compose.yml, not
# here -- see docker-compose.yml's api-ui comment for the full argument
# (RawMatchStore doesn't implement the now-deleted in-process peer path's
# peer-game methods, so api-ui must route peer comparisons through PEERS over
# gRPC instead, unconditionally since Phase 9 deleted `peers_mode`). Accepted
# tradeoff: PEERS' async NotifyPeerBaselineReady callback can never reach
# api-ui (it never hosts a RunnerServiceServicer), so a slow-path baseline
# resolved from an api-ui-originated request degrades to a timeout-and-skip
# for that one build rather than crashing.

# Port RUNNER's gRPC service listens on inside the compose network.
RUNNER_GRPC_PORT=50051

# Port RUNNER's Prometheus /metrics HTTP server listens on.
RUNNER_METRICS_PORT=9100

# Port CRON-watch's gRPC service listens on inside the compose network.
CRON_WATCH_GRPC_PORT=50052

# Port CRON-watch's Prometheus /metrics HTTP server listens on.
CRON_WATCH_METRICS_PORT=9101

# CRON-watch's own Riot API key (separate from RIOT_API_KEY above, per the
# one-key-per-service-type design -- CRON-watch's WatchPoller detection calls
# share nothing with the monolith's/RUNNER's rate-limit budget).
CRON_WATCH_RIOT_API_KEY=RGAPI-your-cron-watch-key-here

# Port PEERS' gRPC service listens on inside the compose network.
PEERS_GRPC_PORT=50053

# Port PEERS' Prometheus /metrics HTTP server listens on.
PEERS_METRICS_PORT=9102

# PEERS' own Riot API key (separate from RIOT_API_KEY/CRON_WATCH_RIOT_API_KEY
# above, per the same one-key-per-service-type design).
PEERS_RIOT_API_KEY=RGAPI-your-peers-key-here

# Platform PEERS resolves league-v4/summoner-v4 lookups against when a
# RequestBaseline call carries no platform of its own. Default: derived from
# PEERS_REGION below (e.g. "euw1" for "europe").
# PEERS_PLATFORM=euw1

# Region group PEERS falls back to when neither a request nor PEERS_PLATFORM
# supplies a platform. Default: europe.
# PEERS_REGION=europe

# Directory PEERS caches its HTTP responses and match store under. Default: .cache/peers.
# PEERS_CACHE_DIR=.cache/peers

# Max concurrent resolve_peer_baseline resolutions PEERS' executor runs at
# once. Default: 4.
# PEERS_MAX_CONCURRENT_BASELINES=4

# Grafana admin credentials, consumed by the `grafana` service in
# docker-compose.yml (Phase 6, Task 4) via GF_SECURITY_ADMIN_USER/
# GF_SECURITY_ADMIN_PASSWORD env vars. NEVER hardcode real values into
# docker-compose.yml -- only placeholders belong here; set real values in the
# gitignored .env file.
GF_SECURITY_ADMIN_USER=admin
GF_SECURITY_ADMIN_PASSWORD=change-me

# Optional overrides (see config.toml.example)
# ANALYZER_RIOT_ID=YourName
# ANALYZER_TAGLINE=EUW
# ANALYZER_REGION=europe
