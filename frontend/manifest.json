{
  "pill": {
    "component": "src/components/Pill.svelte",
    "outputs": [
      {
        "file": "pill_scope_chip.html",
        "props": { "tone": "flat", "label": "{{ scope }}", "dot": false, "variant": "outline" }
      },
      {
        "file": "pill_scope_chip_window.html",
        "props": { "tone": "flat", "label": "{{ scope }}", "dot": false, "variant": "outline", "extraClass": "scope-chip--window" }
      }
    ]
  },
  "filter_button": {
    "component": "src/components/FilterButton.svelte",
    "outputs": [
      {
        "file": "queue_filter_button_enabled.html",
        "props": {
          "dataAttr": "data-queue",
          "buttonClass": "queue-filter-btn game-window-btn",
          "value": "{{ option.key }}",
          "label": "{{ option.label }}",
          "activeClass": "{% if option.key == queue_filter_default %}is-active{% endif %}",
          "disabled": false
        }
      },
      {
        "file": "queue_filter_button_disabled.html",
        "props": {
          "dataAttr": "data-queue",
          "buttonClass": "queue-filter-btn game-window-btn",
          "value": "{{ option.key }}",
          "label": "{{ option.label }}",
          "activeClass": "{% if option.key == queue_filter_default %}is-active{% endif %}",
          "disabled": true
        }
      },
      {
        "file": "game_window_button_enabled.html",
        "props": {
          "dataAttr": "data-window",
          "buttonClass": "game-window-btn",
          "value": "{{ option.key }}",
          "label": "{{ option.label }}",
          "activeClass": "{% if option.key == game_window_default %}is-active{% endif %}",
          "disabled": false
        }
      },
      {
        "file": "game_window_button_disabled.html",
        "props": {
          "dataAttr": "data-window",
          "buttonClass": "game-window-btn",
          "value": "{{ option.key }}",
          "label": "{{ option.label }}",
          "activeClass": "{% if option.key == game_window_default %}is-active{% endif %}",
          "disabled": true
        }
      }
    ]
  },
  "rec_extend_button": {
    "component": "src/components/RecExtendButton.svelte",
    "outputs": [
      {
        "file": "rec_extend_button_positive.html",
        "props": {
          "targetId": "rec-more-positive",
          "label": "Show {{ positive_recommendations|length - recommendation_visible_count }} more strength{{ 's' if positive_recommendations|length - recommendation_visible_count != 1 else '' }}"
        }
      },
      {
        "file": "rec_extend_button_negative.html",
        "props": {
          "targetId": "rec-more-negative",
          "label": "Show {{ negative_recommendations|length - recommendation_visible_count }} more area{{ 's' if negative_recommendations|length - recommendation_visible_count != 1 else '' }} to improve"
        }
      }
    ]
  },
  "metric_label_span": {
    "component": "src/components/MetricLabelSpan.svelte",
    "outputs": [
      {
        "file": "metric_label_span.html",
        "props": {
          "iconHtml": "{{ metric_icon(icon, tone, iconify_id, icon_href) }}",
          "label": "{{ label }}"
        }
      },
      {
        "file": "metric_label_span_with_role.html",
        "props": {
          "roleIconHtml": "{{ role_icon(role_icon_href) }}",
          "iconHtml": "{{ metric_icon(icon, tone, iconify_id, icon_href) }}",
          "label": "{{ label }}"
        }
      }
    ]
  },
  "metric_tooltip": {
    "component": "src/components/MetricTooltip.svelte",
    "outputs": [
      {
        "file": "metric_tooltip.html",
        "props": { "label": "{{ label }}", "tooltip": "{{ tooltip }}" }
      }
    ]
  },
  "peer_driver_row": {
    "component": "src/components/PeerDriverRow.svelte",
    "outputs": [
      {
        "file": "peer_driver_row_above.html",
        "props": {
          "tone": "above",
          "label": "{{ metric_label(row.label, row.iconify, row.icon_tone, icon_href=row.icon_href) }}",
          "values": "{{ row.yours }} vs {{ row.peer_avg }}",
          "gap": "{{ row.gap }}",
          "gapColor": "{{ row.gap_color }}"
        }
      },
      {
        "file": "peer_driver_row_below.html",
        "props": {
          "tone": "below",
          "label": "{{ metric_label(row.label, row.iconify, row.icon_tone, icon_href=row.icon_href) }}",
          "values": "{{ row.yours }} vs {{ row.peer_avg }}",
          "gap": "{{ row.gap }}",
          "gapColor": "{{ row.gap_color }}"
        }
      }
    ]
  },
  "hero_action": {
    "component": "src/components/HeroAction.svelte",
    "outputs": [
      {
        "file": "hero_action.html",
        "props": { "anchor": "{{ tip.anchor }}", "index": "{{ tip_index }}", "label": "{{ tip.action or tip.title }}" }
      }
    ]
  },
  "positioning_hint": {
    "component": "src/components/PositioningHint.svelte",
    "outputs": [
      {
        "file": "positioning_hint.html",
        "props": { "tone": "{{ hint.tone }}", "text": "{{ hint.text }}" }
      }
    ]
  },
  "form_wr_bridge": {
    "component": "src/components/FormWrBridge.svelte",
    "outputs": [
      {
        "file": "form_wr_bridge.html",
        "props": {
          "from": "{{ '%.0f' % (form_snapshot.baseline_winrate * 100) }}%",
          "to": "{{ '%.0f' % (form_snapshot.recent_winrate * 100) }}%",
          "deltaClass": "{% if form_snapshot.winrate_delta_pp > 0 %}form-wr-delta--up{% elif 0 > form_snapshot.winrate_delta_pp %}form-wr-delta--down{% endif %}",
          "deltaText": "{%- if form_snapshot.winrate_delta_pp > 0 %}up {{ '%.0f' % form_snapshot.winrate_delta_pp }}{% elif 0 > form_snapshot.winrate_delta_pp %}down {{ '%.0f' % (-form_snapshot.winrate_delta_pp) }}{% else %}no change{% endif -%}"
        }
      }
    ]
  },
  "peer_rank_value": {
    "component": "src/components/PeerRankValue.svelte",
    "outputs": [
      {
        "file": "peer_rank_value.html",
        "props": { "icon": "{{ peer_rank_icon }}", "label": "{{ peer_comparison.rank_label }}" }
      },
      {
        "file": "peer_rank_value_no_icon.html",
        "props": { "label": "{{ peer_comparison.rank_label }}" }
      }
    ]
  },
  "metric_value": {
    "component": "src/components/MetricValue.svelte",
    "outputs": [
      {
        "file": "metric_value.html",
        "props": {
          "value": "{{ card.value }}",
          "valueClass": "{{ card.value_class }}",
          "valueColor": "{{ card.value_color }}"
        }
      }
    ]
  },
  "metric_benchmark": {
    "component": "src/components/MetricBenchmark.svelte",
    "outputs": [
      {
        "file": "metric_benchmark.html",
        "props": {
          "benchmark": "{{ card.benchmark }}",
          "benchmarkTone": "{{ card.benchmark_tone | default('inline') }}",
          "benchmarkColor": "{{ card.benchmark_color }}"
        }
      }
    ]
  },
  "rec_card_head": {
    "component": "src/components/RecCardHead.svelte",
    "outputs": [
      {
        "file": "rec_card_head.html",
        "props": {
          "badge": "{{ rec.badge }}",
          "priorityLabel": "{{ rec.priority_label }}",
          "category": "{{ rec.category }}",
          "title": "{{ rec.title }}",
          "detail": "{{ rec.detail }}"
        }
      }
    ]
  },
  "rec_evidence_summary": {
    "component": "src/components/RecEvidenceSummary.svelte",
    "outputs": [
      {
        "file": "rec_evidence_summary.html",
        "props": { "text": "{{ rec.evidence_summary }}" }
      }
    ]
  },
  "section_pulse_body": {
    "component": "src/components/SectionPulseBody.svelte",
    "outputs": [
      {
        "file": "section_pulse_body.html",
        "props": { "label": "{{ v.label or 'Score' }}", "title": "{{ v.text or '' }}", "score": "{{ v.score }}" }
      }
    ]
  },
  "section_pulse_hint": {
    "component": "src/components/SectionPulseHint.svelte",
    "outputs": [
      {
        "file": "section_pulse_hint.html",
        "props": { "text": "{{ v.hint or v.value }}" }
      }
    ]
  },
  "section_pulse_fix": {
    "component": "src/components/SectionPulseFix.svelte",
    "outputs": [
      {
        "file": "section_pulse_fix.html",
        "props": { "anchor": "{{ v.fix.anchor or 'coaching' }}", "title": "{{ v.fix.title }}" }
      }
    ]
  },
  "callout_head": {
    "component": "src/components/CalloutHead.svelte",
    "outputs": [
      {
        "file": "callout_head_peer.html",
        "props": { "prefix": "peer-callout", "label": "{{ 'Fix' if kind == 'fix' else 'Keep' }}", "title": "{{ parts[0] }}" }
      },
      {
        "file": "callout_head_story.html",
        "props": { "prefix": "form-story", "label": "{{ 'Keep' if story.tone == 'keep' else 'Fix' }}", "title": "{{ story.title }}" }
      }
    ]
  },
  "callout_detail": {
    "component": "src/components/CalloutDetail.svelte",
    "outputs": [
      {
        "file": "callout_detail.html",
        "props": { "detail": "{{ parts[1:] | join(': ') }}" }
      }
    ]
  },
  "form_story_line": {
    "component": "src/components/FormStoryLine.svelte",
    "outputs": [
      {
        "file": "form_story_line_driver.html",
        "props": { "variant": "driver", "value": "{{ story.driver }}" }
      },
      {
        "file": "form_story_line_habit.html",
        "props": { "variant": "habit", "value": "{{ story.habit }}" }
      },
      {
        "file": "form_story_line_action.html",
        "props": { "variant": "action", "value": "{{ story.action }}" }
      }
    ]
  },
  "data_table_head": {
    "component": "src/components/DataTableHead.svelte",
    "outputs": [
      {
        "file": "data_table_head_blind_spots.html",
        "props": { "columns": [
          { "html": "Zone" },
          { "html": "{{ metric_label(\"Deaths\", \"skull\", \"danger\") }}" }
        ] }
      },
      {
        "file": "data_table_head_form_delta.html",
        "props": { "columns": [
          { "html": "Metric" }, { "html": "Recent" }, { "html": "Baseline" }, { "html": "Change" }, { "html": "Verdict" }
        ] }
      },
      {
        "file": "data_table_head_peer_details.html",
        "props": { "columns": [
          { "html": "Metric" },
          { "html": "You" },
          { "html": "{{ peer_comparison.tier|title }} {{ build_label }} avg", "id": "peer-table-peer-header" },
          { "html": "Gap" },
          { "html": "Verdict" }
        ] }
      },
      {
        "file": "data_table_head_items_cores.html",
        "props": { "columns": [
          { "html": "Core" }, { "html": "Games" }, { "html": "Win rate" },
          { "html": "{{ metric_label(\"Avg DPM\", \"flame\", \"orange\") }}" },
          { "html": "{{ metric_label(\"Avg deaths\", \"skull\", \"danger\") }}" }
        ] }
      },
      {
        "file": "data_table_head_runes.html",
        "props": { "columns": [
          { "html": "Keystone" }, { "html": "Games" }, { "html": "Win rate" },
          { "html": "{{ metric_label(\"Avg DPM\", \"flame\", \"orange\") }}" },
          { "html": "{{ metric_label(\"Avg deaths\", \"skull\", \"danger\") }}" }
        ] }
      },
      {
        "file": "data_table_head_objectives.html",
        "props": { "columns": [
          { "html": "Objective" }, { "html": "Count" }, { "html": "Taken" }, { "html": "Present" }, { "html": "Arrived early" },
          { "html": "{{ metric_label(\"Died in setup window (45–10s)\", tooltip=metric_tooltip(\"Died in setup window (45–10s)\")) }}" },
          { "html": "{{ metric_label(\"Wards before\", tooltip=metric_tooltip(\"Wards before\")) }}" }
        ] }
      }
    ]
  },
  "data_table_row": {
    "component": "src/components/DataTableRow.svelte",
    "outputs": [
      {
        "file": "data_table_row_blind_spots.html",
        "props": { "cellsHtml": "<td>{{ row.zone }}</td><td>{{ row.deaths }}</td>" }
      },
      {
        "file": "data_table_row_form_delta.html",
        "props": { "cellsHtml": "<td>{{ metric_label(row.label, row.iconify, row.icon_tone, icon_href=row.icon_href) }}</td><td>{{ row.recent }}</td><td>{{ row.baseline }}</td><td class=\"delta-{{ row.verdict }}\"{% if row.gap_color %} style=\"color: {{ row.gap_color }}\"{% endif %}>{{ row.gap }}</td><td class=\"delta-{{ row.verdict }}\"{% if row.gap_color %} style=\"color: {{ row.gap_color }}\"{% endif %}>{{ row.verdict }}</td>" }
      },
      {
        "file": "data_table_row_peer_details.html",
        "props": { "cellsHtml": "<td>{{ metric_label(row.label, row.iconify or row.icon, row.icon_tone, icon_href=row.icon_href) }}</td><td>{{ row.yours }}</td><td>{{ row.peer_avg }}</td><td class=\"delta-{{ row.verdict }}\"{% if row.gap_color %} style=\"color: {{ row.gap_color }}\"{% endif %}>{{ row.gap }}</td><td class=\"delta-{{ row.verdict }}\"{% if row.gap_color %} style=\"color: {{ row.gap_color }}\"{% endif %}>{{ row.verdict }}</td>" }
      },
      {
        "file": "data_table_row_items_cores.html",
        "props": { "cellsHtml": "<td>{{ core_cell(row.first_item, row.second_item, row.first_item_icon, row.second_item_icon, row.core) }}</td><td>{{ row.games }}</td><td>{{ '%.0f' % (row.winrate * 100) }}%</td><td>{{ row.avg_dpm }}</td><td>{{ row.avg_deaths }}</td>" }
      },
      {
        "file": "data_table_row_runes.html",
        "props": { "cellsHtml": "<td>{% if row.keystone_icon %}<span class=\"icon-cell\"><img src=\"{{ row.keystone_icon }}\" alt=\"\" class=\"game-icon game-icon--sm\"><span>{{ row.keystone }}</span></span>{% else %}{{ row.keystone }}{% endif %}</td><td>{{ row.games }}</td><td>{{ '%.0f' % (row.winrate * 100) }}%</td><td>{{ row.avg_dpm }}</td><td>{{ row.avg_deaths }}</td>" }
      },
      {
        "file": "data_table_row_objectives.html",
        "props": { "cellsHtml": "<td>{{ icon_cell(row.kind|title, row.objective_icon) }}</td><td>{{ row.count }}</td><td>{{ '%.0f' % (row.taken_rate * 100) }}%</td><td>{{ '%.0f' % (row.presence_rate * 100) }}%</td><td>{{ '%.0f' % (row.early_rate * 100) }}%</td><td>{{ '%.0f' % (row.dead_before_rate * 100) }}%</td><td>{{ row.avg_wards_before }}</td>" }
      },
      {
        "file": "data_table_row_matchups.html",
        "props": { "cellsHtml": "<td>{% if row.opponent_icon %}<span class=\"icon-cell\"><img src=\"{{ row.opponent_icon }}\" alt=\"\" class=\"game-icon game-icon--sm\"><span>{{ row.opponent }}</span></span>{% else %}{{ row.opponent }}{% endif %}</td><td>{{ row.games }}</td><td>{{ '%.0f' % (row.winrate * 100) }}%</td><td><span class=\"matchup-verdict matchup-verdict--{{ row.verdict | default('even') }}\">{{ row.verdict_label | default('Even') }}</span></td><td>{% if row.avg_gd10 is not none %}{% if row.gd10_color %}<span class=\"matchup-metric\" style=\"color: {{ row.gd10_color }}\">{{ '%+.0f' % row.avg_gd10 }}</span>{% else %}{{ '%+.0f' % row.avg_gd10 }}{% endif %}{% else %}—{% endif %}</td>{% if show_cs_stats %}<td>{% if row.avg_csd10 is not none %}{% if row.csd10_color %}<span class=\"matchup-metric\" style=\"color: {{ row.csd10_color }}\">{{ '%+.0f' % row.avg_csd10 }}</span>{% else %}{{ '%+.0f' % row.avg_csd10 }}{% endif %}{% else %}—{% endif %}</td>{% endif %}<td>{% if row.avg_deaths_pre14 is not none %}{% if row.deaths_pre14_color %}<span class=\"matchup-metric\" style=\"color: {{ row.deaths_pre14_color }}\">{{ '%.1f' % row.avg_deaths_pre14 }}</span>{% else %}{{ '%.1f' % row.avg_deaths_pre14 }}{% endif %}{% else %}—{% endif %}</td><td class=\"matchup-plan\">{% if row.focus %}<span class=\"matchup-focus matchup-focus--{{ row.focus_key | default('standard') }}\">{{ row.focus }}</span>{% endif %}<span class=\"matchup-tip\">{{ row.recommendation }}</span></td>" }
      }
    ]
  },
  "tab_bar": {
    "component": "src/components/TabBar.svelte",
    "outputs": [
      {
        "file": "tab_bar_report_category.html",
        "props": {
          "containerId": "report-category-tabs",
          "ariaLabel": "Report categories",
          "buttonClass": "report-tab",
          "dataAttr": "data-category",
          "tabs": [
            { "value": "summary", "label": "Summary", "active": true, "modifierClass": "summary", "ariaControls": "category-summary", "id": "tab-summary" },
            { "value": "performance", "label": "Performance", "active": false, "modifierClass": "performance", "ariaControls": "category-performance", "id": "tab-performance" },
            { "value": "games", "label": "Game Review", "active": false, "modifierClass": "games", "ariaControls": "category-games", "id": "tab-games" },
            { "value": "champion", "label": "Champion", "active": false, "modifierClass": "champion", "ariaControls": "category-champion", "id": "tab-champion" },
            { "value": "deepdive", "label": "Deep Dive", "active": false, "modifierClass": "deepdive", "ariaControls": "category-deepdive", "id": "tab-deepdive" }
          ]
        }
      },
      {
        "file": "tab_bar_form.html",
        "props": {
          "containerId": "form-tabs",
          "buttonClass": "form-tab",
          "dataAttr": "data-tab",
          "tabs": [
            { "value": "pulse", "label": "Pulse", "active": true },
            { "value": "evidence", "label": "Evidence", "active": false }
          ]
        }
      },
      {
        "file": "tab_bar_peer.html",
        "props": {
          "containerId": "peer-tabs",
          "buttonClass": "peer-tab",
          "dataAttr": "data-tab",
          "tabs": [
            { "value": "gaps", "label": "Gaps", "active": true },
            { "value": "drivers", "label": "Drivers", "active": false },
            { "value": "details", "label": "Details", "active": false }
          ]
        }
      },
      {
        "file": "tab_bar_game_review.html",
        "props": {
          "containerId": "game-review-tabs",
          "buttonClass": "game-review-tab",
          "dataAttr": "data-tab",
          "tabs": [
            { "value": "overview", "label": "Overview", "active": true },
            { "value": "story", "label": "Story", "active": false },
            { "value": "key-moments", "label": "Key Moments", "active": false },
            { "value": "loadout", "label": "Loadout", "active": false }
          ]
        }
      }
    ]
  },
