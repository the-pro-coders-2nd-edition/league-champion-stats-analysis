{
  "id": null,
  "uid": "runner-overview",
  "title": "runner",
  "tags": [
    "league-champion-stats"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "panels": [
    {
      "type": "timeseries",
      "title": "Jobs completed by kind & status",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(runner_jobs_total[5m])) by (kind, status)",
          "legendFormat": "{{kind}} ({{status}})",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Job duration by kind (p95)",
      "description": "Safe as a timeseries given the tiny fixed cardinality (3 job kinds), unlike api-ui's 19-route problem.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(runner_job_duration_seconds_bucket[5m])) by (le, kind))",
          "legendFormat": "{{kind}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Stage duration breakdown (p50/p95)",
      "description": "fetch/analyze/peer -- directly answers \"which stage is the bottleneck,\" which the old single aggregate duration panel could not.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(rate(runner_stage_duration_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "p50 {{stage}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(runner_stage_duration_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "p95 {{stage}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Jobs in flight",
      "description": "The one signal for the unbounded-thread-per-job risk: EnqueueJob spawns a brand-new threading.Thread per job with no pool/queue/backpressure (service.py). This gauge only makes that visible -- it does not fix it; bounding that concurrency is a separate follow-up.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "runner_jobs_in_flight",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "PEERS RequestBaseline latency & outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(runner_peers_request_duration_seconds_bucket[5m])) by (le, outcome))",
          "legendFormat": "p95 {{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "PEERS async baseline wait (p50/p95)",
      "description": "Wide buckets to 900s -- a long-tail wait shape, not typical request latency.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum(rate(runner_peers_async_wait_duration_seconds_bucket[5m])) by (le, outcome))",
          "legendFormat": "p50 {{outcome}}",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(runner_peers_async_wait_duration_seconds_bucket[5m])) by (le, outcome))",
          "legendFormat": "p95 {{outcome}}",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Riot API -- request duration by endpoint (p95)",
      "description": "Cross-cutting Riot API client metrics, filtered to job=\"runner\".",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum(rate(riot_api_request_duration_seconds_bucket{job=\"runner\"}[5m])) by (le, endpoint))",
          "legendFormat": "{{endpoint}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Riot API -- requests by outcome",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum(rate(riot_api_requests_total{job=\"runner\"}[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Process CPU / memory",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "rate(process_cpu_seconds_total{job=\"runner\"}[5m])",
          "legendFormat": "cpu (cores)",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "process_resident_memory_bytes{job=\"runner\"}",
          "legendFormat": "resident memory (bytes)",
          "refId": "B"
        }
      ]
    },
    {
      "type": "logs",
      "title": "runner logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessages": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"runner\"} != `/metrics`",
          "refId": "A"
        }
      ]
    }
  ]
}
